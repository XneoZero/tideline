# 复制为 .env 后填写。只在服务端读取，不发送到浏览器。
FEED_LLM_API_KEY=
FEED_LLM_BASE_URL=https://api.deepseek.com
FEED_LLM_MODEL=deepseek-chat
FEED_API_TOKEN=
# AstrBot 专用只读令牌，建议与 Whale 令牌使用不同值。
ASTRBOT_API_TOKEN=
# 可选：从已有 AI information 公开导出文件导入。
# AI_INFORMATION_FEED_PATH=/absolute/path/to/public-feed.json
PORT=4317
# X 浏览器默认使用 Windows 已启用的系统代理；可显式覆盖。
# FEED_X_PROXY=http://127.0.0.1:7877
